# .gitignore
# Files and folders that Git should NOT track

# Virtual Environment
venv/
env/
.venv/
.env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
*.egg

# Jupyter Notebook
.ipynb_checkpoints/

# Environment variables
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Model artifacts ( regenerated by training)
artifacts/model.pkl
artifacts/preprocessor.pkl
artifacts/metrics.json

# Data (large file, download separately)
data/medical_insurance.csv

# Logs
*.log
logs/

# User data (generated at runtime)
data/users.json
